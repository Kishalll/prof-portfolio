# Animated background for every page: waves | honeycomb | none
VITE_BACKGROUND_STYLE=waves

# GitHub contribution graph (hero). Server-side only - do NOT add a VITE_ prefix to these,
# anything starting with VITE_ is bundled into the public site.
# Create a token at github.com/settings/tokens (classic, no scopes needed for public contributions;
# add "read:user" if you also want private contributions counted).
GITHUB_TOKEN=
GITHUB_USERNAME=Kishalll
# rolling = last 12 months (default) | year = 1 Jan of this year -> today
GITHUB_RANGE=rolling
